    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@types/node": "^22.8.6",
    "@vue/test-utils": "^2.4.6",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
