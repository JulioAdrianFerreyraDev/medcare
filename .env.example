# PostgreSQL 16
DB_URL=jdbc:postgresql://localhost:5432/medcare
DB_USERNAME=medcare
DB_PASSWORD=medcare_password

# Redis 7
REDIS_HOST=localhost
REDIS_PORT=6379

# Cloudflare R2 Object Storage (S3-Compatible - Zero-Binary Media Pipeline)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com
R2_REGION=auto
R2_BUCKET_NAME=medcare-clinical-media
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_PRESIGNED_PUT_TTL_MINUTES=15
R2_PRESIGNED_GET_TTL_MINUTES=5
